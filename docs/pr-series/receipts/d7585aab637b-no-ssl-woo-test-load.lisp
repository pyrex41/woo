(load "<HOME>/quicklisp/setup.lisp")
(ql:quickload :cffi :silent t)
(dolist (d (list #P"<HOME>/.local/Homebrew/lib/" #P"<HOME>/.nix-profile/lib/")) (pushnew d cffi:*foreign-library-directories* :test #'equal))
(pushnew :woo-no-ssl *features*)
(push #P"<HOME>/projects/woo-pr-series/13-managed-clack/" asdf:*central-registry*)
(asdf:load-asd #P"<HOME>/projects/woo-pr-series/13-managed-clack/woo.asd")
(asdf:load-asd #P"<HOME>/projects/woo-pr-series/13-managed-clack/woo-test.asd")
(ql:quickload "woo-test" :silent t)
(assert (equal (truename (asdf:system-source-directory (asdf:find-system "woo"))) (truename #P"<HOME>/projects/woo-pr-series/13-managed-clack/")))
(uiop:quit 0)
